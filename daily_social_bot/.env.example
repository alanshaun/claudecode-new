# ── Twitter / X ──────────────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# ── 小红书 ────────────────────────────────────────────────
# 浏览器登录后从 DevTools → Application → Cookies 复制
XHS_COOKIE=

# ── Claude API ───────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── 企业微信应用 ──────────────────────────────────────────
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_AGENT_ID=
WECOM_TO_USER=@all          # 或指定 userid
# 回调验证（企业微信后台配置）
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=

# ── 服务配置 ──────────────────────────────────────────────
CALLBACK_SERVER_PORT=8080
# 公网回调地址（企业微信后台填写）
CALLBACK_URL=https://your-domain.com/wecom/callback
