# ========================================================
# GlobalMatch-Agent-V1 环境变量配置
# 复制本文件为 .env 并填入真实值
# ========================================================

# ---- Kimi API ----
# 获取地址: https://platform.moonshot.cn/console/api-keys
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# ---- Supabase ----
# 获取地址: https://supabase.com/dashboard -> 项目设置 -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx

# ---- Redis ----
# 本地开发: redis://localhost:6379/0
# Docker: redis://redis:6379/0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- 用户SMTP邮件配置（用于发送开发信）----
# Gmail示例: smtp.gmail.com:587
# 163邮箱示例: smtp.163.com:465
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true
SMTP_FROM_NAME=Your Company Name

# ---- 用户IMAP邮件配置（用于监控回复）----
# Gmail: imap.gmail.com:993
# 163邮箱: imap.163.com:993
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_app_password
IMAP_USE_SSL=true

# ---- Server酱微信通知 ----
# 获取地址: https://sct.ftqq.com/ (免费，扫码绑定)
SERVERCHAN_SEND_KEY=SCTxxxxxxxxxxxxxxxxxx

# ---- WhatsApp Business API（可选）----
# 获取地址: https://business.facebook.com/
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- 应用配置 ----
APP_ENV=development
APP_SECRET_KEY=change_this_to_random_string_32chars
DEBUG=false
LOG_LEVEL=INFO

# ---- Chainlit配置 ----
CHAINLIT_AUTH_SECRET=change_this_to_random_string
# 不启用认证（测试阶段）
CHAINLIT_NO_AUTH=true

# ---- 爬虫配置 ----
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000
SCRAPER_MAX_RETRIES=3
SCRAPER_DELAY_MIN=1
SCRAPER_DELAY_MAX=3
# 每次搜索最大结果数限制（防止内存溢出）
MAX_RESULTS_PER_SOURCE=50
